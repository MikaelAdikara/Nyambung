# Salin ke .env (tidak di-commit) atau set sebagai variabel lingkungan sebelum menjalankan uvicorn.
# Format: token:Nama;token2:Nama 2 — setiap token minimal 16 karakter. Server hanya menyimpan SHA-256-nya.
NYAMBUNG_THERAPIST_TOKENS=ganti-dengan-token-acak-panjang:Bu Rina (ilustratif)

# Opsional. Bawaan: server/data/nyambung.db
# NYAMBUNG_DB_PATH=server/data/nyambung.db

# Frasa bersuara (opsional). Boleh juga diisi di .env akar repo. Tanpa kunci, fitur itu tampil "belum aktif".
# OPENAI_API_KEY=        # suara papan cowo/cewe untuk frasa baru (gpt-4o-mini-tts)
# ELEVENLABS_API_KEY=    # klon suara keluarga, hanya setelah orang tua menyetujui di aplikasi
